rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAuthor(gameId) {
      return signedIn()
        && get(/databases/$(database)/documents/games/$(gameId)).data.authorId == uid();
    }

    function isHost(sessionId) {
      return signedIn()
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId == uid();
    }

    // Профили авторов
    match /users/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role == 'author';
      allow update: if signedIn() && uid() == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if signedIn() && uid() == userId;
      allow list: if false;
    }

    // Игры: читает только автор (кабинет/редактор/ведущий).
    // Игроки и экран получают нужные данные из сессии (gameTitle, publicQuestion).
    match /games/{gameId} {
      allow get, list: if signedIn()
        && resource.data.authorId == uid();
      allow create: if signedIn()
        && request.resource.data.authorId == uid();
      allow update, delete: if signedIn()
        && resource.data.authorId == uid();

      // Вопросы содержат правильные ответы — читает только автор
      match /questions/{questionId} {
        allow read: if isAuthor(gameId);
        allow write: if isAuthor(gameId);
      }
    }

    // Медиатека: файлы вопросов (картинки и аудио) в виде data URL.
    // Читать может любой участник/экран, писать — только автор файла.
    match /media/{mediaId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 850000;
      allow update: if signedIn()
        && resource.data.authorId == uid()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 850000;
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    // Коды подключения: публичный get по коду
    match /joinCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostId == uid()
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.hostId == uid();
      allow delete: if signedIn() && resource.data.hostId == uid();
    }

    // Сессии: публичный get по ID нужен игрокам и экрану.
    // Правильные ответы в сессии не хранятся; менять сессию может только ведущий.
    match /sessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostId == uid()
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.authorId == uid();
      allow update, delete: if isHost(sessionId);

      // Участники: имена видны всем, меняет только ведущий
      match /participants/{participantId} {
        allow read: if true;
        allow write: if isHost(sessionId);
      }

      // Публичная метка «имя занято»
      match /claims/{participantId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(participantId));
        allow update: if false;
        allow delete: if isHost(sessionId);
      }

      // Секретный токен участника: пишется один раз, читает только ведущий
      match /tokens/{participantId} {
        allow read: if isHost(sessionId);
        allow create: if exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(participantId))
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 16;
        allow update: if false;
        allow delete: if isHost(sessionId);
      }

      // Ответы и «нажатия»: пишет участник со своим токеном, читает ведущий
      match /answers/{answerId} {
        allow read: if isHost(sessionId);
        allow create: if request.resource.data.participantId is string
          && request.resource.data.questionId is string
          && request.resource.data.token is string
          && exists(/databases/$(database)/documents/sessions/$(sessionId)/tokens/$(request.resource.data.participantId))
          && get(/databases/$(database)/documents/sessions/$(sessionId)/tokens/$(request.resource.data.participantId)).data.token
            == request.resource.data.token;
        allow update: if false;
        allow delete: if isHost(sessionId);
      }
    }
  }
}
